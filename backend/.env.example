# swing-trade-radar backend configuration
# Copy to `.env` and fill in. All keys are OPTIONAL — the app runs without them,
# degrading gracefully (calendars fail-open, yfinance fallbacks for prices/earnings).
# Env var names are case-insensitive (pydantic-settings).

# --- Data source API keys --------------------------------------------------
# AlphaVantage: price + earnings-calendar fallback. Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# FRED (macro release dates: CPI, NFP, etc.). Free, instant: https://fredaccount.stlouisfed.org/apikeys
# Note: FRED's per-IP limit is twitchy — the client already paces ~250ms + 429 backoff.
FRED_API_KEY=

# Finnhub (primary earnings calendar, 60 req/min free tier). Free: https://finnhub.io/register
FINNHUB_API_KEY=

# --- Calendars (macro + earnings) -----------------------------------------
# CALENDARS_ENABLED=true
# CALENDAR_HORIZON_DAYS=14
# CALENDAR_REFRESH_HOUR_UTC=6        # daily refresh_calendars job, 06:00 UTC
# CALENDAR_REFRESH_MINUTE_UTC=0
# MACRO_BLACKOUT_HOURS=48            # suppress new longs N hours before CPI/FOMC/NFP
# EARNINGS_EXIT_HOURS=24             # clamp hold to exit N hours before an earnings print

# --- Scheduler -------------------------------------------------------------
# REFRESH_CRON_ENABLED=true          # price refresh once/day after US close
# REFRESH_CRON_HOUR=16
# REFRESH_CRON_MINUTE=5
# MARKET_TIMEZONE=America/New_York
# REFRESH_ON_BOOT=true

# --- Storage ---------------------------------------------------------------
# DATABASE_URL=sqlite:///./var/swing.db

# --- API -------------------------------------------------------------------
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
